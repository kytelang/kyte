//! HTTP cookie construction for the `Set-Cookie` response header.
//!
//! This module models a single cookie as a `Cookie` value struct and turns it
//! into the wire-format string via `toSetCookie`. It is a builder, not a parser:
//! it does not read `Cookie` request headers sent by the client, only produces
//! the `Set-Cookie` value a server hands back. It is used by the web framework
//! when a handler wants to set a session, flash, or preference cookie.

import collections.string_builder;
import assert;

/// A single HTTP cookie, ready to be turned into a `Set-Cookie` header value
/// via `toSetCookie`. Fields left at their zero value (empty string, or a
/// negative `maxAge`) are omitted from the serialized output rather than
/// written out empty.
pub struct Cookie {
    /// The cookie's name, written before the `=` in the header value.
    pub name: string,
    /// The cookie's value, written after the `=`.
    pub value: string,
    /// `Path` attribute. Omitted from the output when empty.
    pub path: string,
    /// `Domain` attribute. Omitted from the output when empty.
    pub domain: string,
    /// `Max-Age` attribute in seconds. Omitted from the output when negative;
    /// a non-negative value (including 0) is always emitted.
    pub maxAge: int,
    /// Whether to append the `Secure` attribute (cookie sent only over HTTPS).
    pub secure: bool,
    /// Whether to append the `HttpOnly` attribute (cookie hidden from JS).
    pub httpOnly: bool,
    /// `SameSite` attribute value (for example `"Lax"`, `"Strict"`, `"None"`).
    /// Omitted from the output when empty.
    pub sameSite: string,
}

/// Renders a `Cookie` into the `name=value; Attr=...` form suitable for a
/// `Set-Cookie` header. Attributes with an empty string or a negative
/// `maxAge` are skipped; boolean attributes (`Secure`, `HttpOnly`) are
/// appended only when true, with no value.
/// Strips CR, LF and NUL from a cookie field. A crafted name, value or
/// attribute carrying these bytes would otherwise inject an extra `Set-Cookie`
/// header or split the response (header injection); they have no legitimate
/// place in a cookie field, so stripping them is safe.
fn stripCtl(s: string): string {
    let i = 0;
    let dirty = false;
    while (i < s.length) {
        let c = s[i];
        if (c == 13 || c == 10 || c == 0) { dirty = true; break; }
        i = i + 1;
    }
    if (!dirty) { return s; }
    let sb = string_builder.StringBuilder();
    let j = 0;
    while (j < s.length) {
        let c = s[j];
        if (c != 13 && c != 10 && c != 0) { sb.appendChar(c); }
        j = j + 1;
    }
    let r = sb.toString();
    sb.delete();
    return r;
}

// Renders a `Cookie` to its `Set-Cookie` header value. Named `toSetCookie`, not
// `serialize`, so it does not collide with `serde.bson.serialize` in the shared
// free-function namespace: an app that imports both `web.*` and `serde.bson`
// otherwise resolved a bare `serialize(cookie)` to the BSON overload (which
// returns `ptr`), breaking this module's own tests when compiled in that closure.
pub fn toSetCookie(cookie: Cookie): string {
    let sb = string_builder.StringBuilder();
    sb.append(stripCtl(cookie.name));
    sb.append("=");
    sb.append(stripCtl(cookie.value));

    if (cookie.path != "") {
        sb.append("; Path=");
        sb.append(stripCtl(cookie.path));
    }
    if (cookie.domain != "") {
        sb.append("; Domain=");
        sb.append(stripCtl(cookie.domain));
    }
    if (cookie.maxAge >= 0) {
        sb.append("; Max-Age=");
        sb.append(`${cookie.maxAge}`);
    }
    if (cookie.secure) {
        sb.append("; Secure");
    }
    if (cookie.httpOnly) {
        sb.append("; HttpOnly");
    }
    if (cookie.sameSite != "") {
        sb.append("; SameSite=");
        sb.append(stripCtl(cookie.sameSite));
    }
    let res = sb.toString();
    sb.delete();
    return res;
}

@test
fn test_cookie_serialization(): void {
    let cookie = Cookie{
        name: "session",
        value: "xyz123",
        path: "/",
        domain: "example.com",
        maxAge: 3600,
        secure: true,
        httpOnly: true,
        sameSite: "Lax",
    };
    let s = toSetCookie(cookie);
    assert.isTrue(s == "session=xyz123; Path=/; Domain=example.com; Max-Age=3600; Secure; HttpOnly; SameSite=Lax");
}

@test
fn test_cookie_strips_crlf(): void {
    // A value carrying CR/LF must not be able to inject a second header.
    let cookie = Cookie{
        name: "sid",
        value: "a\r\nSet-Cookie: admin=1",
        path: "",
        domain: "",
        maxAge: -1,
        secure: false,
        httpOnly: false,
        sameSite: "",
    };
    let s = toSetCookie(cookie);
    assert.isTrue(s == "sid=aSet-Cookie: admin=1");
}
