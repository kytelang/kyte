//! Baseline security headers for the web framework.
//!
//! Provides `SecureHeadersMiddleware`, a `RouteMiddleware` implementation that
//! stamps a fixed set of defensive HTTP response headers (CSP, frame options,
//! content type sniffing protection, HSTS, XSS protection, referrer policy) onto
//! every response. Register it once near the top of the chain (via `app.use`) so
//! the headers apply uniformly across routes.

import web.routing;
import web.response;

/// Middleware that adds a standard set of security-related response headers.
///
/// The header values are fixed except for `csp`, which callers may override after
/// construction (e.g. `mw.csp = "default-src 'self'; script-src 'self'"`) before
/// registering the middleware with the app.
pub struct SecureHeadersMiddleware impl RouteMiddleware {
    /// Content-Security-Policy header value. Defaults to `default-src 'self'`.
    pub csp: string,

    init() {
        self.csp = "default-src 'self'";
    }

    /// Runs the chain, then stamps the security headers onto the response on the
    /// way out. Never short-circuits the request.
    async fn handle(self: SecureHeadersMiddleware, ctx: routing.Context, next: routing.Chain): Response {
        let res = await next.proceed(ctx);
        res.setHeader("Content-Security-Policy", self.csp);
        res.setHeader("X-Frame-Options", "DENY");
        res.setHeader("X-Content-Type-Options", "nosniff");
        res.setHeader("Strict-Transport-Security", "max-age=31536000; includeSubDomains");
        // Modern defaults: X-XSS-Protection is deprecated (and can introduce bugs in old
        // browsers) so it is no longer sent; Referrer-Policy uses the recommended
        // strict-origin-when-cross-origin; Permissions-Policy denies powerful features by default.
        res.setHeader("Referrer-Policy", "strict-origin-when-cross-origin");
        res.setHeader("Permissions-Policy", "geolocation=(), microphone=(), camera=()");
        return res;
    }
}
