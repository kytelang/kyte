// Order views as NSX: checkout form, confirmation, the live status view (with a
// kitchen -> delivery progress bar), and the order-history list where every
// order subscribes to its own SSE stream and updates live. See DESIGN.md
// sections 8-9.
import Shared.fmt;
import Shared.orderstatus;
import list;
import Domain.Contracts.cart;
import Domain.Contracts.orders;

// The checkout form. Inputs bind to Datastar signals; the button posts them.
pub fn checkoutForm(s: cart.CartSummaryDto): Html {
    return <div id="content" class="flex-1 overflow-y-auto p-6 max-w-md" data-signals="{name: '', email: '', delivery: 'pickup'}">
        <h1 class="text-xl font-bold text-slate-800 mb-4">Checkout</h1>
        <div class="bg-white border border-slate-200 rounded-xl p-5 space-y-3">
            <input data-bind="name" placeholder="Full name" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm" />
            <input data-bind="email" placeholder="Email" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm" />
            <select data-bind="delivery" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm">
                <option value="pickup">Pickup</option>
                <option value="delivery">Delivery</option>
            </select>
            <div class="flex justify-between text-base font-bold text-slate-800 pt-2 border-t border-slate-100">
                <span>Total</span><span>{`£${fmt.money(s.total)}`}</span>
            </div>
            <button class="w-full px-4 py-2.5 rounded-lg text-white bg-emerald-600 hover:bg-emerald-700 transition"
                    data-on:click={"@post('/checkout')"}>Pay and place order</button>
            <p class="text-xs text-slate-400 text-center">Payment is a mock for this demo.</p>
        </div>
    </div>;
}

// The live status view for one order: the current label plus a seven-segment
// progress bar (kitchen -> delivery). Its id is per-order so several of these
// can update independently on the My-orders page. This is the element the SSE
// stream patches on every advance.
pub fn statusView(orderId: string, orderNumber: string, status: string): Html {
    let cur = orderstatus.step(status);
    let st = orderstatus.stages();
    return <div id={`order-status-${orderId}`}>
        <p class="text-sm font-semibold text-emerald-700">{orderstatus.label(status)}</p>
        <div class="flex items-center gap-1 mt-2">
            {for (i in 0..st.size()) {
                let cls = if (i <= cur) "h-1.5 flex-1 rounded-full bg-emerald-500" else "h-1.5 flex-1 rounded-full bg-slate-200";
                <div class={cls}></div>;
            }}
        </div>
    </div>;
}

// The confirmation page. The wrapper opens the order's live status stream once;
// statusView inside it is what the stream morphs as the order progresses.
pub fn confirmation(o: orders.OrderDto): Html {
    return <div id="content" class="flex-1 overflow-y-auto p-6 max-w-md">
        <h1 class="text-xl font-bold text-emerald-700 mb-2">Thank you!</h1>
        <p class="text-sm text-slate-500 mb-4">{`Order ${o.orderNumber} has been placed.`}</p>
        <div class="p-4 rounded-xl bg-white border border-slate-200"
             data-on-intersect={`@get('/orders/${o.id}/events')`}>
            {statusView(o.id, o.orderNumber, o.status)}
        </div>
        <button class="mt-4 text-sm text-emerald-700" data-on:click={"@get('/products')"}>Order again</button>
    </div>;
}

// A logged-in user's order history. Every row opens its own SSE stream (the
// wrapper's data-on-intersect) so the status bar updates live as the kitchen
// and delivery partner advance the order, with no page reload. This is the SSE
// proof: open this page, advance an order from /admin, watch the bar move.
pub fn history(list_: list.List<orders.OrderDto>): Html {
    if (list_.size() == 0) {
        return <div id="content" class="flex-1 overflow-y-auto p-6 max-w-xl"><h1 class="text-xl font-bold text-slate-800 mb-4">Your orders</h1><p class="text-slate-400">No orders yet.</p></div>;
    }
    return <div id="content" class="flex-1 overflow-y-auto p-6 max-w-xl">
        <h1 class="text-xl font-bold text-slate-800 mb-4">Your orders</h1>
        <div class="space-y-3">
            {for (i in 0..list_.size()) {
                let o = list_.get(i) ?? orders.OrderDto{ id: "", orderNumber: "", status: "", subtotal: 0.0, tax: 0.0, total: 0.0 };
                <div class="bg-white border border-slate-200 rounded-xl p-4"
                     data-on-intersect={`@get('/orders/${o.id}/events')`}>
                    <div class="flex items-center justify-between mb-1">
                        <p class="text-sm font-semibold text-slate-800">{o.orderNumber}</p>
                        <span class="text-sm font-semibold text-slate-800">{`£${fmt.money(o.total)}`}</span>
                    </div>
                    {statusView(o.id, o.orderNumber, o.status)}
                </div>;
            }}
        </div>
    </div>;
}
