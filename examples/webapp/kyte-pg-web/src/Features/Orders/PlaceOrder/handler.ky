import web.routing;
import string;
import Features.Orders.PlaceOrder.command;
import Features.Orders.Shared.OrderRepository;
import Features.Orders.Mappers.orderMappers;
import Features.Orders.views.orders;
import Shared.authsession;
import web.session;
import ds_response;
import web.response;

pub struct PlaceOrderHandler impl RouteHandler {
    repo: OrderRepository,
    sessions: SessionStore,
    init(repo: OrderRepository, sessions: SessionStore) { self.repo = repo; self.sessions = sessions; }
    async fn serve(self: PlaceOrderHandler, ctx: routing.Context): Response { let c = ctx.bind<PlaceOrder>();
        if (!authsession.csrfOk(ctx, c.csrf)) { return authsession.csrfForbidden(); }
        // Attribute the order to the logged-in user (if any), from the session.
        let uid = authsession.uidOf(ctx, self.sessions);
        let oid = await self.repo.placeOrder(c.cartid, uid, c.delivery);
        if (string.eql(oid, "")) {
            return await ds_response.patch("<div id=\"content\" class=\"flex-1 overflow-y-auto p-6 text-slate-400\">Your cart is empty.</div>");
        }
        let ord = await self.repo.order(oid);
        // Map the freshly-created Order entity to its confirmation DTO.
        let o = orderMappers.toOrderDto(ord.items.get(0) ?? orderMappers.emptyOrder());
        return await ds_response.patch(orders.confirmation(o));
    }
}
