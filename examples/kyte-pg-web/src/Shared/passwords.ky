// Password hashing for the shop, over the crypto standard library. Passwords are
// never stored in clear: a random salt plus a PBKDF2-SHA256 derivation are
// stored as "<saltHex>$<hashHex>" and verified by recomputing. See DESIGN.md
// section 10.
import crypto.kdf.pbkdf2;
import crypto.random;
import bytes;
import string;

fn toHex(buf: long, n: int): string {
    let out = bytes.alloc(n * 2);
    let i = 0;
    while (i < n) {
        let b = bytes.read_byte(buf, i);
        let hi = (b >> 4) & 15;
        let lo = b & 15;
        bytes.write_byte(out, i * 2, if (hi < 10) hi + 48 else hi + 87);
        bytes.write_byte(out, i * 2 + 1, if (lo < 10) lo + 48 else lo + 87);
        i = i + 1;
    }
    return out as string;
}

fn derive(pw: string, saltHex: string): string {
    let out = bytes.alloc(32);
    pbkdf2.pbkdf2Sha256(pw, pw.length, saltHex, saltHex.length, 100000, out, 32);
    let hex = toHex(out, 32);
    bytes.free(out);
    return hex;
}

// Returns a storable "<saltHex>$<hashHex>" for `pw`.
pub fn hash(pw: string): string {
    let saltHex = random.randomHex(16);
    return saltHex + "$" + derive(pw, saltHex);
}

// True when `pw` matches a previously stored hash.
pub fn verify(pw: string, stored: string): bool {
    let idx = string.indexOf(stored, "$");
    if (idx < 0) { return false; }
    let saltHex = string.slice(stored, 0, idx);
    let want = string.slice(stored, idx + 1, stored.length);
    return string.eql(derive(pw, saltHex), want);
}
