// The staff operations console views. The order table reuses admin.orderRow with
// the actor's role, so the advance button only appears on orders this role owns.
// See DESIGN.md section 11.
import Shared.fmt;
import Shared.orderstatus;
import Features.Admin.views.admin;
import list;
import Domain.Contracts.orders;

pub fn console(role: string, rows: list.List<orders.OrderDto>): Html {
    return <div id="content" class="flex-1 overflow-y-auto p-6">
        <h1 class="text-xl font-bold text-slate-800 mb-1">{`${orderstatus.roleLabel(role)} console`}</h1>
        <p class="text-sm text-slate-400 mb-4">Advance each order through your stages. Customers see the change live on their orders.</p>
        {if (rows.size() == 0) {
            <div class="text-slate-400 text-sm bg-white border border-slate-200 rounded-xl p-6 text-center">No orders in your queue right now.</div>;
        } else {
            <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
                <table class="w-full">
                    <thead><tr class="text-left text-xs text-slate-400 uppercase">
                        <th class="px-3 py-2">Order</th><th class="px-3 py-2">Status</th><th class="px-3 py-2 text-right">Total</th><th class="px-3 py-2"></th>
                    </tr></thead>
                    <tbody>
                        {for (i in 0..rows.size()) {
                            let o = rows.get(i) ?? orders.OrderDto{ id: "", orderNumber: "", status: "", subtotal: 0.0, tax: 0.0, total: 0.0 };
                            admin.orderRow(o, role);
                        }}
                    </tbody>
                </table>
            </div>;
        }}
        <button class="mt-4 text-sm text-emerald-700" data-on:click={"@get('/ops')"}>Refresh queue</button>
    </div>;
}

pub fn notStaff(): Html {
    return <div id="content" class="flex-1 overflow-y-auto p-6 max-w-md">
        <h1 class="text-xl font-bold text-slate-800 mb-2">Operations console</h1>
        <p class="text-sm text-slate-500">This console is for kitchen operators and delivery partners. Log in with a staff account, or register one.</p>
        <div class="mt-3 flex gap-2">
            <button class="text-sm px-3 py-1.5 rounded-lg bg-emerald-600 text-white" data-on:click={"@get('/login')"}>Log in</button>
            <button class="text-sm px-3 py-1.5 rounded-lg bg-slate-100" data-on:click={"@get('/register')"}>Register</button>
        </div>
    </div>;
}

pub fn adminHint(): Html {
    return <div id="content" class="flex-1 overflow-y-auto p-6 max-w-md">
        <h1 class="text-xl font-bold text-slate-800 mb-2">You are an administrator</h1>
        <p class="text-sm text-slate-500">Use the Admin dashboard for the full order list across all stages.</p>
        <button class="mt-3 text-sm px-3 py-1.5 rounded-lg bg-emerald-600 text-white" data-on:click={"@get('/admin')"}>Open Admin dashboard</button>
    </div>;
}
