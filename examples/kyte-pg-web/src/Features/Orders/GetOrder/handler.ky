import web.routing;

import Features.Orders.GetOrder.query;

import Features.Orders.Shared.OrderRepository;

import Features.Orders.Mappers.orderMappers;

import Features.Orders.views.orders;

import ds_response;

import web.response;

pub struct GetOrderHandler impl RouteHandler {
    repo: OrderRepository,

    init(repo: OrderRepository) {
        self.repo = repo;
    }

    async fn serve(self: GetOrderHandler, ctx: Context): Response {
        let q = ctx.bind<GetOrder>();
        let ord = await self.repo.order(q.id);
        let o0 = ord.items.get(0);
        if (o0 == undefined) {
            return await ds_response.patch("<div id=\"content\" class=\"flex-1 overflow-y-auto p-6 text-slate-400\">Order not found</div>");
        }
        let o = orderMappers.toOrderDto(o0 ?? orderMappers.emptyOrder());
        return await ds_response.patch(orders.confirmation(o));
    }
}
