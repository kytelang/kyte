import web.routing;
import Features.Auth.GetLogin.query;
import Features.Auth.views.auth;
import ds_response;
import web.response;
pub struct GetLoginHandler impl RouteHandler {
    init() { }
    async fn serve(self: GetLoginHandler, ctx: routing.Context): Response { let q = ctx.bind<GetLogin>(); return await ds_response.patch(auth.loginForm()); }
}
