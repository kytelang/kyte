// Kitchen / delivery board views. One phase-parameterised board ("kitchen" or
// "delivery"), split into two columns: Available (unclaimed orders a staff
// member can Pick) and My orders (what they have claimed, with Advance and
// Release). The board's inner region carries id="board-<phase>" so the live SSE
// feed (Board/Events/sse.ky) can re-render just that region on an interval as
// orders arrive, get claimed, or hand off between phases. See DESIGN.md.
//
// NSX escaping: a value-position `{expr}` is HTML-escaped when it is a plain
// string (so user text like an order number is safe by default), but a call to a
// VIEW helper -- a function that returns NSX markup, like `{availList(...)}` or
// `{boardInner(...)}` -- is inserted raw, so sub-views compose naturally. Use
// `raw(s)` to insert a trusted string unescaped.
import Shared.fmt;
import Shared.orderstatus;
import list;
import Domain.Contracts.orders;

fn zeroOrder(): orders.OrderDto {
    return orders.OrderDto{ id: "", orderNumber: "", status: "", subtotal: 0.0, tax: 0.0, total: 0.0, paid: false };
}

// One Available (unclaimed) order: shows the order and a Pick button that claims
// it into the actor's "My orders". `phase` drives the claim URL (/kitchen/claim
// or /delivery/claim).
pub fn availRow(phase: string, o: orders.OrderDto): Html {
    return <div class="flex items-center justify-between px-3 py-2 border-t border-slate-100">
        <div>
            <p class="text-sm font-medium text-slate-700">{o.orderNumber}</p>
            <p class="text-xs text-slate-400">{orderstatus.label(o.status)} &middot; {`£${fmt.money(o.total)}`}</p>
        </div>
        <button class="text-xs px-3 py-1 rounded bg-emerald-600 text-white hover:bg-emerald-700"
                data-on:click={`@post('/${phase}/claim?order=${o.id}')`}>Pick</button>
    </div>;
}

// One claimed order in "My orders": Advance (if this phase still owns the order's
// stage) and Release (hand it back to the Available pool).
pub fn mineRow(phase: string, o: orders.OrderDto): Html {
    let st = o.status;
    return <div class="flex items-center justify-between px-3 py-2 border-t border-slate-100">
        <div>
            <p class="text-sm font-medium text-slate-700">{o.orderNumber}</p>
            <p class="text-xs text-slate-400">{orderstatus.label(st)} &middot; {`£${fmt.money(o.total)}`}</p>
        </div>
        <div class="flex items-center gap-2">
            {if (orderstatus.canAdvance(phase, st)) {
                <button class="text-xs px-3 py-1 rounded bg-emerald-600 text-white hover:bg-emerald-700"
                        data-on:click={`@post('/${phase}/advance?order=${o.id}')`}>{`Advance to: ${orderstatus.label(orderstatus.next(st))}`}</button>;
            } else {
                <span class="text-xs text-slate-400">Handed off</span>;
            }}
            <button class="text-xs px-2 py-1 rounded border border-slate-200 text-slate-500 hover:bg-slate-50"
                    data-on:click={`@post('/${phase}/release?order=${o.id}')`}>Release</button>
        </div>
    </div>;
}

pub fn availList(phase: string, avail: list.List<orders.OrderDto>): Html {
    if (avail.size() == 0) {
        return <div class="px-3 py-6 text-center text-xs text-slate-400 border-t border-slate-100">Nothing waiting.</div>;
    }
    return <div>{for (i in 0..avail.size()) { availRow(phase, avail.get(i) ?? zeroOrder()); }}</div>;
}

pub fn mineList(phase: string, mine: list.List<orders.OrderDto>): Html {
    if (mine.size() == 0) {
        return <div class="px-3 py-6 text-center text-xs text-slate-400 border-t border-slate-100">You have not picked any orders yet.</div>;
    }
    return <div>{for (i in 0..mine.size()) { mineRow(phase, mine.get(i) ?? zeroOrder()); }}</div>;
}

// The live-updated region: the Available and My-orders columns. Re-rendered whole
// by the SSE feed (patched by its id="board-<phase>"). Sub-views compose by call
// (`{availList(...)}`), inserted raw since they return NSX markup.
pub fn boardInner(phase: string, avail: list.List<orders.OrderDto>, mine: list.List<orders.OrderDto>): Html {
    return <div id={`board-${phase}`} class="grid grid-cols-2 gap-4">
        <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
            <div class="px-3 py-2 bg-slate-50 flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Available</span>
                <span class="text-xs text-slate-400">{`${avail.size()}`}</span>
            </div>
            {availList(phase, avail)}
        </div>
        <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
            <div class="px-3 py-2 bg-slate-50 flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">My orders</span>
                <span class="text-xs text-slate-400">{`${mine.size()}`}</span>
            </div>
            {mineList(phase, mine)}
        </div>
    </div>;
}

// The full board page (into #content): a header, a one-shot element that opens
// the live queue stream, and the board region. `phase` is "kitchen" or "delivery".
pub fn board(phase: string, avail: list.List<orders.OrderDto>, mine: list.List<orders.OrderDto>): Html {
    return <div id="content" class="flex-1 overflow-y-auto p-6">
        <h1 class="text-xl font-bold text-slate-800 mb-1">{`${orderstatus.roleLabel(phase)} board`}</h1>
        <p class="text-sm text-slate-400 mb-4">Pick an order to work on it. Your board updates live as new orders arrive.</p>
        <div data-on-intersect={`@get('/${phase}/events')`}></div>
        {boardInner(phase, avail, mine)}
    </div>;
}

// Shown when a non-staff (or wrong-role) user opens a board.
pub fn notAllowed(phase: string): Html {
    return <div id="content" class="flex-1 overflow-y-auto p-6 max-w-md">
        <h1 class="text-xl font-bold text-slate-800 mb-2">{`${orderstatus.roleLabel(phase)} board`}</h1>
        <p class="text-sm text-slate-500">This board is for staff. Log in with the right staff account, or register one.</p>
        <div class="mt-3 flex gap-2">
            <button class="text-sm px-3 py-1.5 rounded-lg bg-emerald-600 text-white" data-on:click={"@get('/login')"}>Log in</button>
            <button class="text-sm px-3 py-1.5 rounded-lg bg-slate-100" data-on:click={"@get('/register')"}>Register</button>
        </div>
    </div>;
}
