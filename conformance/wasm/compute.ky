// Canonical wasm-target example: the SYNCHRONOUS subset only.
//
// async/await, the reactor, and everything built on them (HTTP, sockets, TLS, the
// database drivers) do NOT lower to wasm, so this example stays pure: integers, long,
// value structs, generics, ARC-managed List, control flow. It needs zero host imports.
// Built with `kyte --target wasm` and, when wasm-ld is on PATH, linked to a runnable
// module and executed by conformance/run.sh --wasm (which checks the exported results).
import list;

/// A value struct, to exercise value semantics + generic instantiation on wasm.
struct Point { x: long, y: long }

/// Integer control flow. Returns the nth Fibonacci number.
export fn fib(n: long): long {
    if (n < 2) { return n; }
    let a: long = 0;
    let b: long = 1;
    let i: long = 2;
    while (i <= n) {
        let t = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    return b;
}

/// Generics + a value struct stored in an ARC-managed List + control flow.
/// Builds n points (i, i+1) and returns the sum of every coordinate.
export fn sumPoints(n: long): long {
    let pts = List<Point>();
    let i: long = 0;
    while (i < n) {
        pts.push(Point { x: i, y: i + 1 });
        i = i + 1;
    }
    let total: long = 0;
    let j = 0;
    while (j < pts.size()) {
        let p = pts.at(j);
        total = total + p.x + p.y;
        j = j + 1;
    }
    return total;
}

/// int is 32-bit with wraparound; the wasm result must match a native build exactly.
export fn overflow32(): int {
    let x = 2000000000;
    let y = 2000000000;
    return x + y;
}
