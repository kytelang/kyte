// Regression: a value-optional produced by `?? default` and passed DIRECTLY as a nested
// call argument must lower to a plain value, not a boxed optional. This shape historically
// crashed (the boxed optional reached a value consumer), and the workaround was to bind it
// to a local first. It must now work inline, both for a value-struct optional and a scalar
// optional, under repetition.

import assert;

struct Box { v: int }
fn wrapBox(x: int): Box? { if (x > 0) { return Box { v: x }; } return undefined; }
fn takeBox(b: Box): int { return b.v; }

fn wrapInt(x: int): int? { if (x > 0) { return x; } return undefined; }
fn takeInt(n: int): int { return n * 2; }

@test
fn t_nested_value_struct_optional_arg(): void {
    let i = 0;
    while (i < 50) {
        // coalesced value-struct optional, straight into a value-consuming call
        assert.equalInt(takeBox(wrapBox(5) ?? Box { v: 0 }), 5);
        assert.equalInt(takeBox(wrapBox(0 - 1) ?? Box { v: 9 }), 9);   // fallback taken
        i = i + 1;
    }
}

@test
fn t_nested_scalar_optional_arg(): void {
    let i = 0;
    while (i < 50) {
        assert.equalInt(takeInt(wrapInt(4) ?? 0), 8);
        assert.equalInt(takeInt(wrapInt(0 - 1) ?? 3), 6);              // fallback taken
        i = i + 1;
    }
}
