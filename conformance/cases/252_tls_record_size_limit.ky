// Regression + interop tests for the TLS 1.3 server's record_size_limit
// handling, and a full membio client<->server handshake.
//
// Bug this guards against: the server used to emit a record_size_limit
// extension (0x001c) in EncryptedExtensions unconditionally. A client that did
// not offer record_size_limit (every mainstream browser) must reject an
// unsolicited extension (RFC 8446 4.2 -> unsupported_extension), so Chrome,
// Brave and Safari aborted the handshake (ERR_SSL_PROTOCOL_ERROR) while lenient
// stacks (openssl, curl) silently ignored it. The fix gates the echo on
// TlsServer.clientSentRecordSizeLimit. These tests pin both branches.
//
// TLS 1.2 (mTLS) client+server is covered by 249/250/251.

import crypto.tls.13.tlsServer;
import net.tlsmembio;
import bytes;
import assert;

const SRV_CERT: string = "";
const SRV_PRIV: string = "accfe82d31600d5810b9984176898804a4ba458216b1ac913231be5008ca82f1";

fn hexNib(c: int): int { if (c >= 48 && c <= 57) { return c - 48; } if (c >= 97 && c <= 102) { return c - 87; } return 0; }
fn hexBuf(hex: string): ptr {
    let n = hex.length / 2;
    let b = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])); i = i + 1; }
    return b;
}

// Returns the first offset of the hex pattern in `buf[0..n]`, or -1 if absent.
fn findPattern(out: ptr, n: int, hex: string): int {
    let np = hexBuf(hex);
    let m = hex.length / 2;
    let i = 0;
    while (i + m <= n) {
        let j = 0;
        while (j < m && bytes.read_byte(out, i + j) == bytes.read_byte(np, j)) { j = j + 1; }
        if (j == m) { bytes.free(np); return i; }
        i = i + 1;
    }
    bytes.free(np);
    return 0 - 1;
}

// Builds a server and runs ServerHello + the encrypted flight. The flight's
// EncryptedExtensions is folded into the transcript (trBuf) as plaintext, so we
// can assert on it directly. processClientHello is deliberately NOT called, so
// the only record_size_limit bytes that can appear in trBuf are the server's.
fn serverFlightTranscript(offered: bool): tlsServer.TlsServer {
    let srv = tlsServer.newServer(hexBuf(SRV_CERT), 421, hexBuf(SRV_PRIV), bytes.alloc(32), bytes.alloc(32), bytes.alloc(48));
    srv.clientSentRecordSizeLimit = offered;
    let sh = bytes.alloc(1024);
    let _s = srv.buildServerHello(bytes.alloc(32), sh);
    let out = bytes.alloc(8192);
    let _f = srv.buildFlight(out);
    return srv;
}

// The full record_size_limit extension the server advertises: type 0x001c,
// length 2, value 16385 (0x4001).
const RSL_EXT: string = "001c00024001";

@test
fn server_omits_record_size_limit_when_unsolicited(): void {
    // Client did not offer it -> EncryptedExtensions must not carry it.
    let srv = serverFlightTranscript(false);
    assert.equalInt(findPattern(srv.trBuf, srv.trLen, RSL_EXT), 0 - 1);
}

@test
fn server_echoes_record_size_limit_when_offered(): void {
    // Client offered it -> the server is allowed to (and does) echo it.
    let srv = serverFlightTranscript(true);
    assert.isTrue(findPattern(srv.trBuf, srv.trLen, RSL_EXT) >= 0);
}

fn handshake(cb: tlsmembio.ClientBio, sb: tlsmembio.ServerBio, tmp: ptr): bool {
    let cdone = false; let sdone = false;
    let i = 0;
    while (i < 20 && !(cdone && sdone)) {
        while (cb.pendingOut() > 0) { let n = cb.pull(tmp, 33792); sb.feed(tmp, n); }
        let ss = sb.step();
        if (ss < 0) { return false; }
        if (ss == 0) { sdone = true; }
        while (sb.pendingOut() > 0) { let n = sb.pull(tmp, 33792); cb.feed(tmp, n); }
        let cs = cb.step();
        if (cs < 0) { return false; }
        if (cs == 0) { cdone = true; }
        i = i + 1;
    }
    return cdone && sdone;
}

@test
fn full_handshake_completes_and_carries_app_data(): void {
    // End-to-end client<->server handshake still completes after the fix (the
    // stock Kyte client offers record_size_limit, so the echo path is exercised),
    // and application data flows both ways.
    let cb = tlsmembio.newClientBio("localhost");
    let sb = tlsmembio.newServerBio(hexBuf(SRV_CERT), 421, hexBuf(SRV_PRIV));
    let tmp = bytes.alloc(33792);
    assert.isTrue(handshake(cb, sb, tmp));

    let msg = hexBuf("48454c4c4f"); // "HELLO"
    let _w = cb.writeApp(msg, 5);
    while (cb.pendingOut() > 0) { let n = cb.pull(tmp, 33792); sb.feed(tmp, n); }
    let got = bytes.alloc(64);
    let r = sb.readApp(got, 64);
    assert.equalInt(r, 5);
    assert.isTrue(findPattern(got, r, "48454c4c4f") == 0);
}
