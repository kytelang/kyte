import assert;
import xmod_valopt_helper;

// Acceptance (last-bit-of-hardening B5): a value-optional of a value type passed as an
// argument ACROSS a module boundary must unbox according to the callee's declared slot,
// in both the present and absent cases. This is the residual-verification case for the
// historical value-optional ABI crash; it must run correctly under `KYTE_ASAN=1`.

@test
fn valopt_present_across_module(): void {
    let p: xmod_valopt_helper.Pt? = xmod_valopt_helper.Pt(3, 4);
    assert.equalInt(xmod_valopt_helper.sumOpt(p), 7);
}

@test
fn valopt_absent_across_module(): void {
    let p: xmod_valopt_helper.Pt? = undefined;
    assert.equalInt(xmod_valopt_helper.sumOpt(p), -1);
}

@test
fn valopt_literal_arg_across_module(): void {
    assert.equalInt(xmod_valopt_helper.sumOpt(xmod_valopt_helper.Pt(10, 20)), 30);
}
