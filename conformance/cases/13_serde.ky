import assert;
import serde.source;
import serde.json;
import string;
import list;

@serializable
struct Address {
    pub street: string,
    pub city: string,
    init() { self.street = ""; self.city = ""; }
}

@serializable
struct Item {
    pub sku: string,
    pub qty: long,
    init() { self.sku = ""; self.qty = 0; }
}

@serializable
struct Order {
    pub id: long,
    pub name: string,
    pub paid: bool,
    pub address: Address,
    pub tags: List<string>,
    pub items: List<Item>,
    init() {
        self.id = 0;
        self.name = "";
        self.paid = false;
        self.address = Address();
        self.tags = List<string>();
        self.items = List<Item>();
    }
}

@test
fn test_scalar_and_nested(): void {
    let raw = "{\"id\":7,\"name\":\"Kyte\",\"paid\":true,\"address\":{\"street\":\"Main\",\"city\":\"Pune\"},\"tags\":[],\"items\":[]}";
    let o = Order__bind(source.fromJson(raw));
    assert.equalInt(o.id, 7);
    assert.equalStr(o.name, "Kyte");
    assert.isTrue(o.paid);
    assert.equalStr(o.address.city, "Pune");
    assert.equalStr(o.address.street, "Main");
}

@test
fn test_list_of_primitives(): void {
    let raw = "{\"id\":1,\"name\":\"\",\"paid\":false,\"address\":{\"street\":\"\",\"city\":\"\"},\"tags\":[\"a\",\"b\",\"c\"],\"items\":[]}";
    let o = Order__bind(source.fromJson(raw));
    assert.equalInt(o.tags.size(), 3);
    assert.equalStr(o.tags.get(0) ?? "?", "a");
    assert.equalStr(o.tags.get(2) ?? "?", "c");
}

@test
fn test_list_of_structs(): void {
    let raw = "{\"id\":1,\"name\":\"\",\"paid\":false,\"address\":{\"street\":\"\",\"city\":\"\"},\"tags\":[],\"items\":[{\"sku\":\"A\",\"qty\":2},{\"sku\":\"B\",\"qty\":5}]}";
    let o = Order__bind(source.fromJson(raw));
    assert.equalInt(o.items.size(), 2);
    let i0 = o.items.get(0) ?? Item();
    let i1 = o.items.get(1) ?? Item();
    assert.equalStr(i0.sku, "A");
    assert.equalInt(i0.qty, 2);
    assert.equalStr(i1.sku, "B");
    assert.equalInt(i1.qty, 5);
}

@test
fn test_tojson_roundtrip(): void {
    let it = Item__bind(source.fromJson("{\"sku\":\"A\",\"qty\":2}"));
    assert.equalStr(Item__toJson(it), "{\"sku\":\"A\",\"qty\":2}");

    let a = Address__bind(source.fromJson("{\"street\":\"Main\",\"city\":\"Pune\"}"));
    assert.equalStr(Address__toJson(a), "{\"street\":\"Main\",\"city\":\"Pune\"}");
}

// Compiler-injected `to(fmt)` / `from(fmt, data)` convenience methods (see
// serializable.md). `to` supports Format.json; `from` supports Format.json and
// Format.yaml. Both are additive sugar over the free-function binders above.
@test
fn test_injected_to_from(): void {
    let it = Item.from(Format.json, "{\"sku\":\"A\",\"qty\":2}");
    assert.equalStr(it.sku, "A");
    assert.equalInt(it.qty, 2);
    assert.equalStr(it.to(Format.json), "{\"sku\":\"A\",\"qty\":2}");

    let iy = Item.from(Format.yaml, "sku: B\nqty: 5\n");
    assert.equalStr(iy.sku, "B");
    assert.equalInt(iy.qty, 5);

    let a = Address.from(Format.json, "{\"street\":\"Main\",\"city\":\"Pune\"}");
    assert.equalStr(a.to(Format.json), "{\"street\":\"Main\",\"city\":\"Pune\"}");
}

// A user-defined method wins: injection skips `to` on Widget (its own `to`
// stays), but still adds the static `from`.
@serializable
struct Widget {
    pub label: string,
    init() { self.label = ""; }
    pub fn to(self: Widget): string { return "custom"; }
}

@test
fn test_injected_method_collision(): void {
    let w = Widget.from(Format.json, "{\"label\":\"x\"}");
    assert.equalStr(w.label, "x");
    assert.equalStr(w.to(), "custom");
}
