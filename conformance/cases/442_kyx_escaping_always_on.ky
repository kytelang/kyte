// KYX interpolation escaping must ALWAYS fire, even when nothing in the compile
// references the stdlib escapeHtml (which demand-mono would otherwise prune, silently
// dropping escaping -> XSS). Child `{expr}` string values escape via the always-linked
// runtime `kyte_html_escape`; `data-*`/`@` attribute values are datastar CODE and stay
// raw; `response.raw(x)` embeds a trusted pre-rendered fragment unescaped.
import assert;
import string;
import web.response;

// A view with NO reference to escapeHtml anywhere: proves escaping is not dependent on
// the stdlib helper being pulled into the compile.
fn card(body: string): string { return <div class="card">{body}</div>; }

fn page(userText: string, action: string, childHtml: string): string {
    return <section>
        <p>{userText}</p>
        <button data-on:click={action}>go</button>
        {response.raw(childHtml)}
    </section>;
}

@test
fn test_child_string_is_escaped(): void {
    let h = card("<script>alert('x')</script>");
    assert.isTrue(!string.contains(h, "<script>"));            // raw markup gone
    assert.isTrue(string.contains(h, "&lt;script&gt;"));       // escaped
    assert.isTrue(string.contains(h, "&#39;"));                // ' escaped
}

@test
fn test_all_five_metachars(): void {
    let h = card("a<b>c&d\"e'f");
    assert.isTrue(string.contains(h, "a&lt;b&gt;c&amp;d&quot;e&#39;f"));
}

@test
fn test_no_metachars_passes_through(): void {
    let h = card("plain text 123");
    assert.isTrue(string.contains(h, ">plain text 123<"));
}

@test
fn test_datastar_attr_stays_raw(): void {
    // A computed data-on value keeps its JS quotes (not escaped to &#39;).
    let h = page("hi", "@get('/api/x/' + $id)", "");
    assert.isTrue(string.contains(h, "data-on:click=\"@get('/api/x/' + $id)\""));
}

@test
fn test_response_raw_embeds_unescaped(): void {
    let h = page("hi", "@get('/x')", "<b>trusted</b>");
    assert.isTrue(string.contains(h, "<b>trusted</b>"));       // raw, not &lt;b&gt;
}

// Static KYX text is author-written markup, not interpolated user data, so it is
// emitted verbatim: a numeric HTML entity survives byte-for-byte (the browser
// decodes it), while a bare `&` typed as static text also survives unchanged. A
// bare `&` in an INTERPOLATED `{expr}` string, by contrast, still escapes to
// `&amp;` (that is the injection-prevention point, covered above).
fn entities(): string { return <span>&#128187; &#9881; &amp;</span>; }

@test
fn test_numeric_entities_survive_in_static_text(): void {
    let h = entities();
    assert.isTrue(string.contains(h, "&#128187;"));            // laptop, undecoded in source
    assert.isTrue(string.contains(h, "&#9881;"));              // gear
    assert.isTrue(string.contains(h, "&amp;"));                // literal ampersand entity
}

@test
fn test_bare_amp_in_expr_still_escapes(): void {
    let h = card("a & b");
    assert.isTrue(string.contains(h, "a &amp; b"));            // interpolated -> escaped
}
